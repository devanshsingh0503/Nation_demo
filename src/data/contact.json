  "html": "<script type=\"module\">document.addEventListener(`keydown`,e=>{if(e.key!==`Enter`||e.defaultPrevented)return;let t=e.target;if(t instanceof HTMLSelectElement&&!(t.disabled||t.multiple)&&!t.matches(`:open`)&&typeof t.showPicker==`function`){e.preventDefault();try{t.showPicker()}catch{}}});</script><section data-theme=\"light\" class=\"relative pt-section-md pb-section-md\"><div class=\"relative container-main\"><div class=\"gap-x-3xl gap-y-2xl grid lg:grid-cols-2 lg:items-start\"><div><div data-reveal-scroll=\"\" data-text=\"in\"><p class=\"text-eyebrow bracketed\" data-reveal-block=\"\" style=\"--reveal-line: 0;\">Contact</p><h1 class=\"text-title text-primary mt-xl\" data-split=\"\"><span class=\"sr-only\">A store that runs and markets itself.</span><span class=\"split-lines\" aria-hidden=\"true\"><span class=\"split-line\" style=\"--reveal-line: 1;\">A store that runs</span><span class=\"split-line\" style=\"--reveal-line: 2;\">and markets itself.</span></span></h1><p class=\"text-prose text-secondary mt-xl\" data-split=\"\"><span class=\"sr-only\">Describe what you want to sell in one prompt, or connect with our founders to see Nation in action.</span><span class=\"split-lines\" aria-hidden=\"true\"><span class=\"split-line\" style=\"--reveal-line: 3;\">Describe what you want to sell in one prompt, or connect with our founders</span><span class=\"split-line\" style=\"--reveal-line: 4;\">to see Nation in action.</span></span></p><div class=\"mt-xl gap-md flex flex-wrap\" data-reveal-block=\"\" style=\"--reveal-line: 5;\"><a href=\"https://calendar.app.google/Gkhsnhx3KsdwENfY7\" rel=\"noopener noreferrer\" target=\"_blank\" data-shuffle=\"true\" class=\"inline-flex items-center justify-center rounded-sm border whitespace-nowrap transition-colors duration-spring-soft ease-spring-soft disabled:pointer-events-none disabled:opacity-40 aria-disabled:pointer-events-none aria-disabled:opacity-40 btn-compact h-[2.5rem] px-md gap-xs text-body font-medium md:h-co